{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getgeolens.com/arcgis-inventory/v2/schema.json",
  "title": "GeoLens ArcGIS inventory report v2",
  "description": "Read-only inventory of an ArcGIS Online or Portal for ArcGIS organization, written by `geolens arcgis inventory`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "tool_version",
    "complete",
    "abort_reason",
    "truncated",
    "truncation_reasons",
    "max_items",
    "portal",
    "auth",
    "scope",
    "counts",
    "retirements",
    "items",
    "dependencies",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "tool_version": {"type": "string"},
    "complete": {
      "type": "boolean",
      "description": "False when the run stopped early (a rejected token or a failed listing); the report then holds what was read before the stop."
    },
    "abort_reason": {"type": ["string", "null"]},
    "truncated": {
      "type": "boolean",
      "description": "True when the listing may be incomplete; truncation_reasons says why."
    },
    "truncation_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["max_items", "search_ceiling"]},
      "description": "max_items: the local --max-items cap stopped the listing. search_ceiling: an organization search reached the 10,000 results ArcGIS search returns, so more items may exist whatever the local cap."
    },
    "max_items": {"type": "integer", "minimum": 1},
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "kind", "version", "org_id", "name"],
      "properties": {
        "url": {"type": "string"},
        "kind": {"enum": ["online", "enterprise"]},
        "version": {"type": ["string", "null"]},
        "org_id": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]}
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "user"],
      "properties": {
        "mode": {"enum": ["token", "generateToken", "anonymous"]},
        "user": {"type": ["string", "null"]}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "owner", "org_id"],
      "properties": {
        "mode": {"enum": ["user", "org"]},
        "owner": {"type": ["string", "null"]},
        "org_id": {"type": ["string", "null"]}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_class", "by_type", "retired", "failed"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "by_class": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "partial", "unsupported"],
          "properties": {
            "supported": {"type": "integer", "minimum": 0},
            "partial": {"type": "integer", "minimum": 0},
            "unsupported": {"type": "integer", "minimum": 0}
          }
        },
        "by_type": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "retired": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "retirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "status", "date", "note", "source_url", "item_count"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "status": {"enum": ["retiring", "retired"]},
          "date": {"$ref": "#/$defs/quarter"},
          "note": {"type": "string"},
          "source_url": {"type": "string"},
          "item_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}
  },
  "$defs": {
    "quarter": {
      "description": "Esri announces retirements by quarter; null when no dated source is known.",
      "oneOf": [
        {"type": "string", "pattern": "^[0-9]{4}-Q[1-4]$"},
        {"type": "null"}
      ]
    },
    "timestamp": {"type": ["string", "null"], "format": "date-time"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "type_keywords",
        "title",
        "owner",
        "sharing",
        "size_bytes",
        "created",
        "modified",
        "url",
        "class",
        "reason",
        "retirement",
        "hosted",
        "dependencies_status",
        "snippet",
        "description",
        "tags",
        "access_information",
        "license_info",
        "extent",
        "thumbnail",
        "spatial_reference",
        "culture",
        "folder",
        "groups",
        "owner_full_name",
        "owner_email",
        "layers",
        "data_saved"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string"},
        "type_keywords": {"type": "array", "items": {"type": "string"}},
        "title": {"type": "string"},
        "owner": {"type": "string"},
        "sharing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["access", "groups"],
          "properties": {
            "access": {"type": "string"},
            "groups": {
              "description": "Ids of the groups the item is shared with, for readers of v1; null when group sharing was not read (--no-groups or a failed read). The item's groups list carries the titles.",
              "type": ["array", "null"],
              "items": {"type": "string"}
            }
          }
        },
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "created": {"$ref": "#/$defs/timestamp"},
        "modified": {"$ref": "#/$defs/timestamp"},
        "url": {
          "description": "Scheme, host and path only; query, fragment and userinfo are dropped.",
          "type": ["string", "null"]
        },
        "class": {"enum": ["supported", "partial", "unsupported"]},
        "reason": {"type": "string"},
        "retirement": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status", "date"],
              "properties": {
                "id": {"type": "string"},
                "status": {"enum": ["retiring", "retired"]},
                "date": {"$ref": "#/$defs/quarter"}
              }
            }
          ]
        },
        "hosted": {"type": ["boolean", "null"]},
        "dependencies_status": {
          "enum": ["parsed", "unparsed", "error", "not_fetched", "not_applicable"]
        },
        "snippet": {"type": ["string", "null"]},
        "description": {
          "description": "Raw HTML as the portal stores it, cut at 64 KB.",
          "type": ["string", "null"]
        },
        "tags": {"type": "array", "items": {"type": "string"}},
        "access_information": {
          "description": "The item's credits.",
          "type": ["string", "null"]
        },
        "license_info": {"type": ["string", "null"]},
        "extent": {
          "description": "[[xmin, ymin], [xmax, ymax]] in WGS84, or null.",
          "oneOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {"type": "number"}
              }
            },
            {"type": "null"}
          ]
        },
        "thumbnail": {
          "description": "The thumbnail's path inside the item; the image is not downloaded.",
          "type": ["string", "null"]
        },
        "spatial_reference": {"type": ["string", "null"]},
        "culture": {"type": ["string", "null"]},
        "folder": {
          "description": "The owner's folder holding the item; null for the root folder or when unknown. The title is null when the owner's folder list could not be read.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title"],
              "properties": {
                "id": {"type": "string"},
                "title": {"type": ["string", "null"]}
              }
            }
          ]
        },
        "groups": {
          "description": "Groups the item is shared with that the signing-in account can see: the portal hides private groups the account does not belong to, so the list can be a subset. Null when not read (--no-groups, an anonymous run, or a failed read).",
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"$ref": "#/$defs/group"}}
          ]
        },
        "owner_full_name": {"type": ["string", "null"]},
        "owner_email": {"type": ["string", "null"]},
        "layers": {
          "description": "The sub-layer a Feature or Map Service item's own URL names; no service request is made, so an item pointing at a whole service has none.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "url"],
            "properties": {
              "id": {"type": "integer", "minimum": 0},
              "url": {"type": "string"}
            }
          }
        },
        "data_saved": {
          "description": "True when the item's data JSON was written to webmaps/<id>.json or apps/<id>.json next to the report, with credentials redacted.",
          "type": "boolean"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_id",
        "to_id",
        "to_url",
        "role",
        "layer_type",
        "layer_id",
        "title",
        "order",
        "hosted",
        "resolved",
        "external"
      ],
      "properties": {
        "from_id": {"type": "string"},
        "to_id": {"type": ["string", "null"]},
        "to_url": {"type": ["string", "null"]},
        "role": {
          "description": "app_web_map: a map an app opens. app_data_source: a layer an app reads directly, such as a dashboard chart's dataset; layer_id holds its layer. app_embedded_item: an item a Hub page or site embeds in a card. view_parent: the service a hosted view is cut from. published_from: the source file a hosted layer was published from. survey_results: the service a survey stores its results in.",
          "enum": [
            "operational_layer",
            "basemap",
            "table",
            "app_web_map",
            "app_data_source",
            "app_embedded_item",
            "view_parent",
            "published_from",
            "survey_results"
          ]
        },
        "layer_type": {"type": ["string", "null"]},
        "layer_id": {
          "description": "The layer's id in the source item. A map or tiled map service sublayer with its own query service is \"<parent id>/<sublayer id>\".",
          "type": ["string", "null"]
        },
        "title": {"type": ["string", "null"]},
        "order": {
          "description": "Position among the source item's references, in map order.",
          "type": "integer",
          "minimum": 0
        },
        "hosted": {"type": ["boolean", "null"]},
        "resolved": {
          "description": "True when to_id is an item in this report.",
          "type": "boolean"
        },
        "external": {
          "description": "True when the target belongs to another organization or to a service outside this organization's hosted services, such as Living Atlas content; false for this organization's own content; null when neither the item nor the URL says.",
          "type": ["boolean", "null"]
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "access"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "access": {"type": ["string", "null"]}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "phase", "http_status", "message"],
      "properties": {
        "item_id": {
          "description": "The item's id; for the owner and folders phases, the owner's username.",
          "type": "string"
        },
        "phase": {"enum": ["item_data", "item_details", "item_groups", "related", "owner", "folders"]},
        "http_status": {"type": ["integer", "null"]},
        "message": {"type": "string"}
      }
    }
  }
}
