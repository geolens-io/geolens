{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getgeolens.com/geolens-manifest/v1/schema.json",
  "title": "GeoLens Manifest v1",
  "description": "Versioned geolens.yaml catalog manifest contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "catalog", "datasets"],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1",
      "description": "Manifest schema version. GeoLens v13.7 supports version 1."
    },
    "catalog": {
      "$ref": "#/$defs/catalog"
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/dataset"
      }
    }
  },
  "$defs": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Human-readable catalog title."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "Human-readable catalog description."
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Organization responsible for the catalog."
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 320
            },
            "url": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$",
              "maxLength": 2000
            }
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "sources", "publication"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "description": "Stable dataset identity key used for idempotent apply operations."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Human-readable dataset title."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "Human-readable dataset description."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "publication": {
          "$ref": "#/$defs/publication"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri"],
      "allOf": [
        {
          "if": {
            "properties": {"type": {"const": "vector"}},
            "required": ["type"]
          },
          "then": {
            "properties": {
              "uri": {
                "pattern": "(?i)\\.(?:zip|gpkg|geojson|json|csv|xlsx|xls|fgb|kml|kmz)(?:[?#].*)?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "raster_cog"}},
            "required": ["type"]
          },
          "then": {
            "properties": {
              "uri": {
                "pattern": "(?i)\\.(?:tif|tiff)(?:[?#].*)?$"
              }
            }
          }
        }
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["vector", "raster_cog"],
          "description": "Source modality. Vector sources require zip, gpkg, geojson, json, csv, xlsx, xls, fgb, kml, or kmz; raster_cog sources require tif or tiff."
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^(?:(?:\\.{1,2}/)?[^\\s:/][^\\s:]*|https?://[^\\s]+|s3://[^\\s]+|gs://[^\\s]+|az://[^\\s]+|abfs://[^\\s]+)$",
          "description": "Relative path, HTTP(S) URL, or storage URI."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "layer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "checksum": {
          "type": ["string", "null"],
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Declared SHA-256 digest of the source bytes, as 'sha256:<64 lowercase hex characters>', or null. Apply uses this only as a change-detection input alongside the rest of the entry; it is not verified against the fetched bytes. For a vector source, bump it when the file under a stable URI changes, to force apply to reclassify the entry as an update instead of skipping it. Manifest raster updates are not supported, so a raster_cog source with a changed checksum still cannot be re-imported this way. Mirrors ManifestSource.checksum in backend/app/processing/ingest/manifest_schemas.py; keep the two in step. gh#1773 codex r4: type includes null because ManifestSource.checksum is Optional and the generated OpenAPI schema allows a null variant; minLength/maxLength/pattern apply only to the string branch per JSON Schema semantics."
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "crs": {
          "type": "string",
          "pattern": "^EPSG:[0-9]{1,6}$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "^[^<>]*$",
          "description": "Credit line displayed with the data. Rejects '<' and '>': the API stores this verbatim and the map viewer renders it in MapLibre's attribution control, which is an HTML context. Mirrors ManifestMetadata.attribution in backend/app/processing/ingest/manifest_schemas.py — keep the two in step."
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "description": "WGS84 bbox hint: [minx, miny, maxx, maxy]."
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent"],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "examples": ["draft", "ready", "internal", "published"],
          "description": "Publication intent. Deliberately not an enum: the values come from the server's workflow extension status_order(), so a deployment may define its own and the CLI cannot know that set. The apply endpoint validates against the live extension. Community default order: draft, ready, internal, published."
        }
      }
    }
  }
}
