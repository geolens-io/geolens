{
  "name": "frontend",
  "private": true,
  "version": "1.15.1",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Carto Concepts, LLC",
  "scripts": {
    "dev": "vite",
    "build:app": "vite build",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --noEmit",
    "test:i18n": "node ./scripts/check-i18n-source-keys.mjs && vitest run src/i18n/resources.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "check:i18n:changed": "node ./scripts/check-i18n-changed-namespaces.mjs",
    "check:i18n:toast-strings": "node ./scripts/check-hardcoded-toast.mjs --self-test && node ./scripts/check-hardcoded-toast.mjs --strict",
    "check:i18n:api-errors": "node ./scripts/check-api-error-boundary.mjs",
    "types:generate": "node ./scripts/generate-api-types.mjs",
    "types:check": "node ./scripts/generate-api-types.mjs && git diff --exit-code -- src/types/api.generated.ts",
    "lint:sec-s14-regression": "eslint --no-inline-config src/__tests__/sec-s14-eslint-regression.ts; test $? -ne 0",
    "lint:sec-s14-no-false-positive": "eslint src/__tests__/sec-s14-eslint-regression.skip.ts",
    "lint:sec-fu-03-regression": "eslint --no-inline-config src/__tests__/sec-fu-03-react-no-danger-regression.skip.tsx; test $? -ne 0",
    "lint:sec-fu-03-no-false-positive": "eslint src/__tests__/sec-fu-03-react-no-danger-regression.skip.tsx"
  },
  "overrides": {
    "undici": "^7.28.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@maplibre/maplibre-gl-style-spec": "^26.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@turf/area": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@vis.gl/react-maplibre": "^8.1.2",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.0",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^6.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.0",
    "react-i18next": "^17.0.12",
    "react-router": "^8.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "terra-draw": "^1.32.3",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/chroma-js": "^3.1.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
