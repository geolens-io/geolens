{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Test files count as consumers, so this runs in the default (non-production)
  // mode: an export that only a test imports is reachable code under test, not dead code.
  "entry": [
    // Served as static files from index.html / nginx / docker-entrypoint.sh, never imported.
    "public/*.js",
    // Run by npm scripts and CI, never imported.
    "scripts/*.mjs",
    // Ambient declarations picked up by tsconfig, never imported.
    "src/@types/*.d.ts",
    // Fixtures the sec-* eslint regression scripts lint on purpose.
    "src/__tests__/sec-*.{ts,tsx}"
  ],
  // `uv` runs the OpenAPI flattener in scripts/generate-api-types.mjs; it is a system tool, not an npm package.
  "ignoreBinaries": ["uv"],
  // Generated by scripts/generate-api-types.mjs.
  "ignore": ["src/types/api.generated.ts"],
  "ignoreIssues": {
    // shadcn/ui primitives export their full component set whether or not the app uses each part.
    "src/components/ui/**": ["exports", "types"]
  }
}
