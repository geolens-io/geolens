# syntax=docker/dockerfile:1
# Vite dev server image — runs as non-root `node` user (uid 1000).
# Uses a BuildKit npm cache mount.

FROM node:26.12.0-alpine@sha256:6f08a523443ddedf52941874c203475b0ad503e859ad70cb26ab8be9a517dbd5

WORKDIR /app

# Install deps as root because npm ci writes to global locations + WORKDIR.
# The cache mount is shared across builds to speed up dependency resolution.
# `--chown=node:node` on COPY ensures /app contents are node-owned before
# USER node takes effect; the post-install chown re-owns node_modules so vite
# can write its dep optimizer cache when /app/node_modules is an anon volume.
COPY --chown=node:node package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline && \
    sha256sum package-lock.json | cut -d' ' -f1 > node_modules/.package-lock.sha256 && \
    cp -al node_modules /opt/geolens-node_modules && \
    chown -R node:node /app/node_modules /opt/geolens-node_modules

# Copy source as node user.
COPY --chown=node:node . .

# Drop to non-root for runtime — vite + esbuild + node can hot-reload without privileges.
USER node

EXPOSE 5173
ENTRYPOINT ["sh", "/app/docker-dev-entrypoint.sh"]
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
